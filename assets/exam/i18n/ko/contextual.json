"cx112": {"e":"なつ: 여름.","t":"여름은 더우니까 바다에서 자주 수영해요."},
"cx113": {"e":"ふゆ: 겨울.","t":"겨울은 추워서 별로 좋아하지 않아요."},
"cx114": {"e":"あめが ふる: 비가 오다.","t":"밖에 비가 오고 있으니까 우산을 가지고 가요."},
"cx115": {"e":"いってきます에 대한 대답: いってらっしゃい.","t":"“다녀오겠습니다.” “다녀오세요.”"},
"cx116": {"e":"いただきます: 먹기 전에 하는 말.","t":"밥을 먹기 전에 ‘いただきます(잘 먹겠습니다)’라고 말해요."},
"cx117": {"e":"ただいま에 대한 대답: おかえりなさい.","t":"“다녀왔습니다.” “어서 와요.”"},
"cx118": {"e":"スポーツ: 스포츠. 축구는 스포츠입니다.","t":"저는 스포츠를 좋아해요. 특히 축구를 자주 봐요."},
"cx119": {"e":"かぎを かける: 열쇠로 잠그다.","t":"방을 잠그고 나서 외출해요."},
