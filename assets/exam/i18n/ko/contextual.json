"cx137": {"e":"あく (자동사): 열리다.","t":"이 버튼을 누르면 문이 열려요."},
"cx138": {"e":"しめる (타동사): 닫다.","t":"바람이 세니까 창문을 닫아 주세요."},
"cx139": {"e":"ついて いる: 켜져 있다.","t":"불이 켜져 있네요. 누가 켰어요?"},
"cx140": {"e":"ねつが でる: 열이 나다.","t":"감기에 걸려서 열이 났어요."},
"cx141": {"e":"は: 이. 그래서 밥을 먹을 수 없습니다.","t":"이가 아파서 밥을 먹을 수 없어요."},
"cx142": {"e":"밖이 하얗게 되었습니다.","t":"눈이 와서 밖이 하얗게 되었어요."},
"cx143": {"e":"にわ: 마당, 정원.","t":"마당이 넓어서 아이들이 놀 수 있어요."},
"cx144": {"e":"さら: 접시.","t":"부엌에서 접시를 씻어요."},
"cx145": {"e":"きっさてん: 찻집, 카페.","t":"카페에서 커피를 마시면서 친구와 이야기했어요."},
"cx146": {"e":"ぎんこう: 은행.","t":"은행에서 돈을 찾았어요."},
"cx147": {"e":"ふゆ: 겨울.","t":"일본의 겨울은 2월이 가장 추워요."},
"cx148": {"e":"はる: 봄.","t":"봄이 되면 벚꽃이 피어요."},
"cx149": {"e":"일요일: 회사가 쉽니다.","t":"오늘은 일요일이라서 회사는 쉬어요."},
"cx150": {"e":"テレビ: 텔레비전.","t":"매일 아침 텔레비전을 보고 날씨를 확인해요."},
"cx151": {"e":"でんきを つける: 불을 켜다.","t":"방이 어두우니까 불을 켭시다."},
"cx152": {"e":"エレベーター: 엘리베이터.","t":"엘리베이터를 타고 5층에 가요."},
"cx153": {"e":"ベッド: 침대.","t":"이 침대는 아주 푹신해서 잠이 잘 와요."},
"cx154": {"e":"さとう: 설탕.","t":"커피에 설탕을 넣어요?"},
"cx155": {"e":"ごろ: ~쯤 (시각).","t":"저는 매일 아침 7시쯤 일어나요."},
"cx156": {"e":"ぐらい: ~정도 (시간의 길이).","t":"역까지 걸어서 20분 정도 걸려요."},
"cx157": {"e":"よく できた: 잘했다.","t":"시험은 잘 봤어요. 100점이었어요."},
"cx158": {"e":"ぜんぶ: 전부.","t":"히라가나는 이제 전부 쓸 수 있어요."},
"cx159": {"e":"もうすこし: 조금 더.","t":"전철이 안 와요. 조금 더 기다려요."},
"cx160": {"e":"すぐ: 바로.","t":"수업이 끝나면 바로 집에 가요."},
"cx161": {"e":"ときどき: 가끔.","t":"저는 가끔 요리를 해요. 일주일에 한 번 정도예요."},
"cx162": {"e":"いつも: 항상.","t":"형은 항상 바빠서 별로 만나지 못해요."},
"cx163": {"e":"おなまえは なんですか: 이름이 뭐예요?","t":"“이름이 뭐예요?” “다나카예요.”"},
"cx164": {"e":"だれと: 누구와.","t":"“누구와 갔어요?” “친구와 갔어요.”"},
"cx165": {"e":"いつ: 언제.","t":"“언제 돌아가요?” “다음 주에 돌아가요.”"},
"cx166": {"e":"きる: 자르다.","t":"이 케이크를 네 조각으로 잘라 주세요."},
"cx167": {"e":"ぬれる: 젖다.","t":"비 때문에 옷이 젖어 버렸어요."},
"cx168": {"e":"おくる: 바래다주다.","t":"친구를 역까지 바래다줬어요."},
"cx169": {"e":"おぼえる: 외우다.","t":"이 한자는 쉬워서 금방 외웠어요."},
"cx170": {"e":"やすむ: 쉬다, 결석하다.","t":"병 때문에 3일 동안 학교를 쉬었어요."},
"cx171": {"e":"とめる: 세우다, 주차하다.","t":"여기에 자전거를 세우지 마세요."},
"cx172": {"e":"むずかしい: 어렵다.","t":"일본어로 편지를 쓰는 것은 어려워요."},
"cx173": {"e":"やさしい: 쉽다.","t":"이 책은 쉬워서 아이도 읽을 수 있어요."},
"cx174": {"e":"あかるい: 밝다, 명랑하다.","t":"저 사람은 아주 밝아요. 항상 웃고 있어요."},
"cx175": {"e":"あぶない: 위험하다.","t":"이 나이프는 잘 드니까 위험해요."},
"cx176": {"e":"おおい: 많다.","t":"짐이 많아서 택시로 돌아가요."},
"cx177": {"e":"せまい: 좁다.","t":"이 길은 좁아서 차가 지나갈 수 없어요."},
"cx178": {"e":"つめたい: 차갑다.","t":"더우니까 차가운 것을 마시고 싶어요."},
"cx179": {"e":"어려운 문제: あつい(厚い), 두껍다.","t":"겨울에는 두꺼운 코트를 입고 외출해요."},
"cx180": {"e":"おてあらい: 화장실.","t":"“실례합니다, 화장실은 어디예요?” “저기 계단 옆이에요.”"}
}
